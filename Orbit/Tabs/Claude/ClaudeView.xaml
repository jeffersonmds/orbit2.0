<UserControl x:Class="Orbit.Tabs.Claude.ClaudeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10"
                Visibility="{Binding HooksActive, Converter={StaticResource NotBoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Ativar"
                        Command="{Binding InstallHooksCommand}" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Integração com o Claude Code desligada" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Instala hooks em ~/.claude/settings.json (preserva os que já existem)."
                               FontSize="11" Foreground="{StaticResource InkLo}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock Text="Nenhuma sessão do Claude Code aberta" FontSize="13" Foreground="{StaticResource InkLo}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                <DockPanel>
                                    <Ellipse x:Name="dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,12,0"
                                             Fill="{StaticResource InkLo}" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostRound}" Content="&#xE711;" VerticalAlignment="Center"
                                            ToolTip="Tirar da lista (sessão já fechada)"
                                            Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShortSessionId}" FontSize="11" Margin="0,0,8,0"
                                               Foreground="{StaticResource InkLo}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="{StaticResource InkLo}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="WaitingInput">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="status" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="NeedsAttention">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="status" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
