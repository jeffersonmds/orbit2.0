<UserControl x:Class="Orbit.Tabs.Dispositivos.DispositivosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Esquerda: liga/desliga, endereço, tokens -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Chip}" IsChecked="{Binding Enabled}" Content="Ponte ligada" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource InkLo}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <!-- Sessão de tela remota ativa: quem está no PC vê e pode derrubar -->
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,0,10"
                        Visibility="{Binding RemoteActive, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Encerrar"
                                Command="{Binding StopRemoteCommand}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RemoteText}" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TextBlock Text="Endereço do Tailscale (ex.: https://notebook.tail1234.ts.net)" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding PublicUrl, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="Abrir painel" Margin="0,0,6,0"
                                Command="{Binding OpenEnableUrlCommand}"
                                Visibility="{Binding EnableUrl, Converter={StaticResource NullToCollapsed}}"/>
                        <Button Style="{StaticResource AccentButton}" Content="Publicar no Tailscale" Command="{Binding PublishCommand}"
                                Visibility="{Binding ShowPublish, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource SmallButton}" Content="Despublicar" Command="{Binding UnpublishCommand}"
                                Visibility="{Binding ShowUnpublish, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TailscaleStatus}" FontSize="11.5" Foreground="{StaticResource InkLo}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Abrir pasta" Command="{Binding OpenUploadFolderCommand}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource InkLo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="Arquivos dos aparelhos vão para "/><Run Text="{Binding UploadFolder, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Parear dispositivo" Command="{Binding PairCommand}" Margin="8,0,0,0"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nome do novo dispositivo (opcional)"/>
                </DockPanel>
                <TextBlock Text="Aparelhos com acesso" Style="{StaticResource Label}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Foreground="{StaticResource InkLo}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Precisa do Tailscale no PC e nos aparelhos + 'tailscale serve' (docs/tailscale-setup.md). Nunca use 'tailscale funnel'."/>
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostRound}" Content="&#xE711;" ToolTip="Revogar"
                                                Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastSeenText}" FontSize="11"
                                                   Foreground="{StaticResource InkLo}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="13" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding Camera}"
                                                  Content="Câmera" ToolTip="Permite este dispositivo ver as câmeras do PC"/>
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding PcFiles}"
                                                  Content="Arquivos" ToolTip="Permite ver e baixar arquivos das pastas do usuário (só leitura)"/>
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding Screen}"
                                                  Content="Tela" ToolTip="Permite ver a tela do PC ao vivo"/>
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding Control}" IsEnabled="{Binding Screen}"
                                                  Content="Controle" ToolTip="Permite usar mouse e teclado (precisa de Tela)"/>
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding Mic}"
                                                  Content="Microfone" ToolTip="Permite ouvir o microfone do PC"/>
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding Keyboard}"
                                                  Content="Teclado" ToolTip="Permite digitar (e ditar) no app em foco do PC"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Direita: pareamento (QR) ou atividade recente -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <StackPanel Visibility="{Binding HasPairing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PairCode}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding PairCodeHint}" FontSize="11" Foreground="{StaticResource InkLo}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                    <Border Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Center"
                            Visibility="{Binding QrImage, Converter={StaticResource NullToCollapsed}}">
                        <Image Source="{Binding QrImage}" Width="104" Height="104" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="Ou aponte a câmera (abre no Safari). O link aparece só agora." FontSize="11" Foreground="{StaticResource InkLo}"
                               TextWrapping="Wrap" Margin="0,6,0,4"
                               Visibility="{Binding QrImage, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="Sem endereço do Tailscale: este é só o token (use nos Atalhos). O token aparece só agora."
                               FontSize="11" Foreground="{StaticResource InkLo}" TextWrapping="Wrap" Margin="0,8,0,4"
                               Visibility="{Binding HasQr, Converter={StaticResource NotBoolToVis}}"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding PairLink, Mode=OneWay}" IsReadOnly="True" FontSize="11"/>
                    <Button Style="{StaticResource SmallButton}" Content="Copiar" Command="{Binding CopyPairLinkCommand}"
                            HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Visibility="{Binding HasPairing, Converter={StaticResource NotBoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="Atividade" Style="{StaticResource Label}"/>
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="11" Foreground="{StaticResource InkLo}" Width="40"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontSize="11" Foreground="{StaticResource InkLo}"/>
                                    <TextBlock Text="{Binding Action}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
