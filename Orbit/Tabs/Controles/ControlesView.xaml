<UserControl x:Class="Orbit.Tabs.Controles.ControlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <DockPanel LastChildFill="True">
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12" Visibility="{Binding ShowMixer, Converter={StaticResource NotBoolToVis}}">
            <Grid Margin="0,0,6,0">
                <Button Style="{StaticResource ToggleCard}" Tag="{Binding WifiOn}" Command="{Binding ToggleWifiCommand}" Height="72">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Wi‑Fi" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WifiStatus}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <!-- QR do Wi-Fi pra visita -->
                <Button Style="{StaticResource GhostRound}" Content="&#xED14;" FontSize="13" ToolTip="Compartilhar o Wi-Fi (QR)"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Command="{Binding ShareWifiCommand}"/>
            </Grid>
            <Button Style="{StaticResource ToggleCard}" Tag="{Binding BluetoothOn}" Command="{Binding ToggleBluetoothCommand}" Height="72" Margin="3,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Bluetooth" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BluetoothStatus}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToggleCard}" Tag="{Binding DarkOn}" Command="{Binding ToggleDarkCommand}" Height="72" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Modo escuro" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DarkStatus}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </UniformGrid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Left" Style="{StaticResource RoundButton}" Content="{Binding MuteGlyph}"
                    Command="{Binding ToggleMuteCommand}" Margin="0,0,12,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Command="{Binding ToggleMixerCommand}"
                    Content="{Binding MixerGlyph}" ToolTip="Mixer e saída de áudio" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" FontSize="12"
                       Foreground="{StaticResource InkLo}" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
            <Slider Style="{StaticResource AccentSlider}" Value="{Binding VolumePercent}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" DataContext="{Binding NowPlaying}"
                Visibility="{Binding DataContext.ShowMixer, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotBoolToVis}}">
            <Grid>
                <TextBlock Text="Nada tocando" Foreground="{StaticResource InkLo}" FontSize="13"
                           Visibility="{Binding HasSession, Converter={StaticResource NotBoolToVis}}"/>
                <DockPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="10" Background="{StaticResource CardHover}" Margin="0,0,14,0">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="{StaticResource InkLo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource RoundButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource RoundButton}" Content="&#xE893;" Command="{Binding NextCommand}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource InkLo}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Mixer: saída + volume por app (só existe com ShowMixer) -->
        <Border Style="{StaticResource Card}" Padding="14,12" Visibility="{Binding ShowMixer, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Saída" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding IsDefault, Mode=OneWay}" ToolTip="{Binding Name}"
                                      Command="{Binding DataContext.SetOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding Id}">
                                <TextBlock Text="{Binding Name}" MaxWidth="210" TextTrimming="CharacterEllipsis"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Top" Text="{Binding MixerStatus}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,6" Visibility="{Binding MixerStatus, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock DockPanel.Dock="Top" Text="Apps" Style="{StaticResource Label}" Margin="0,2,0,4"/>
                <Grid>
                    <TextBlock Text="Nenhum app com som agora" FontSize="12" Foreground="{StaticResource InkLo}"
                               Visibility="{Binding HasApps, Converter={StaticResource NotBoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="20" Height="20" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding FallbackGlyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Foreground="{StaticResource InkLo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource AccentSlider}" Value="{Binding Percent}"/>
                                            <!-- medidor ao vivo, fino, embaixo do trilho -->
                                            <Grid Height="2" VerticalAlignment="Bottom" Margin="0,0,0,1" IsHitTestVisible="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Level, Converter={StaticResource FractionToStar}}"/>
                                                    <ColumnDefinition Width="{Binding Level, Converter={StaticResource FractionToStar}, ConverterParameter=rest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#6FD08C" CornerRadius="1"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{Binding Percent, StringFormat={}{0:0}%}" FontSize="11.5"
                                                   Foreground="{StaticResource InkLo}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Button Grid.Column="4" Style="{StaticResource GhostRound}" Content="{Binding MuteGlyph}" FontSize="12"
                                                Command="{Binding ToggleMuteCommand}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>

    <!-- Painel do QR do Wi-Fi: a visita aponta a câmera e entra -->
    <Border Background="{StaticResource CardBg}" CornerRadius="16" Padding="16"
            Visibility="{Binding ShowWifiQr, Converter={StaticResource BoolToVis}}">
        <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource GhostRound}" Content="&#xE711;"
                    ToolTip="Fechar" Command="{Binding CloseWifiQrCommand}"/>
            <Border DockPanel.Dock="Left" Background="White" CornerRadius="12" Padding="8" Width="196" Height="196" Margin="0,0,18,0">
                <Image Source="{Binding WifiQr}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Compartilhar Wi-Fi" FontSize="11" Foreground="{StaticResource InkLo}"/>
                <TextBlock Text="{Binding WifiQrTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <TextBlock Text="Aponte a câmera do celular pro código pra entrar na rede." FontSize="12"
                           Foreground="{StaticResource InkLo}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Style="{StaticResource PlainButton}" HorizontalAlignment="Left" Command="{Binding ToggleWifiPasswordCommand}">
                    <TextBlock Text="{Binding WifiQrPassword}" FontSize="12.5" FontFamily="Consolas"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
</UserControl>
