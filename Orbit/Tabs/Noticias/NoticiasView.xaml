<UserControl x:Class="Orbit.Tabs.Noticias.NoticiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- O cartão inteiro abre a notícia; o ✕ (botão interno) só ignora. -->
                    <Button Style="{StaticResource RowButton}" Margin="0,0,0,6"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostRound}" Content="&#xE711;" VerticalAlignment="Center"
                                    ToolTip="Ignorar"
                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Item.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Domain}" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
