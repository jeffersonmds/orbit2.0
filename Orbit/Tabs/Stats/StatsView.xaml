<UserControl x:Class="Orbit.Tabs.Stats.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Anel de % reutilizado pelos três cartões: Tag = DashArray, Content = %, Header = rótulo -->
        <ControlTemplate x:Key="RingCard" TargetType="HeaderedContentControl">
            <Border Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="84" Height="84">
                        <Ellipse Stroke="#2A2A2E" StrokeThickness="7"/>
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="7" StrokeDashCap="Round"
                                 StrokeDashArray="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,8,0,0"
                                      TextElement.FontSize="12" TextElement.FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <HeaderedContentControl Template="{StaticResource RingCard}" Tag="{Binding CpuRing}" Header="CPU" Margin="0,0,6,0">
                    <TextBlock Text="{Binding CpuText}" FontSize="18" FontWeight="SemiBold"/>
                </HeaderedContentControl>
                <HeaderedContentControl Template="{StaticResource RingCard}" Tag="{Binding RamRing}" Header="RAM" Margin="3,0">
                    <TextBlock Text="{Binding RamText}" FontSize="18" FontWeight="SemiBold"/>
                </HeaderedContentControl>
                <HeaderedContentControl Template="{StaticResource RingCard}" Tag="{Binding GpuRing}" Header="GPU" Margin="6,0,0,0">
                    <TextBlock Text="{Binding GpuText}" FontSize="18" FontWeight="SemiBold"/>
                </HeaderedContentControl>
            </UniformGrid>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="RAM" FontSize="11" Foreground="{StaticResource InkLo}"/>
                        <TextBlock Text="{Binding RamDetail}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Disco C:" FontSize="11" Foreground="{StaticResource InkLo}"/>
                        <TextBlock Text="{Binding DiskText}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Ligado há" FontSize="11" Foreground="{StaticResource InkLo}"/>
                        <TextBlock Text="{Binding UptimeText}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10">
                <DockPanel>
                    <TextBlock Text="Rede" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NetText}" FontSize="13" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Top apps · RAM" Style="{StaticResource Label}"/>
                <ItemsControl ItemsSource="{Binding TopApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock Text="{Binding Memory}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource InkLo}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid Height="4" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStar}}"/>
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="#2A2A2E"/>
                                    <Border CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
