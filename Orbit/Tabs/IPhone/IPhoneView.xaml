<UserControl x:Class="Orbit.Tabs.IPhone.IPhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Esquerda: liga/desliga, endereço, tokens -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,10">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Chip}" IsChecked="{Binding Enabled}" Content="Ponte ligada" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource InkLo}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="Endereço do Tailscale (ex.: https://notebook.tail1234.ts.net)" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding PublicUrl, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Parear iPhone" Command="{Binding PairCommand}"/>
                    <TextBlock Text="Aparelhos com acesso" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Foreground="{StaticResource InkLo}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Precisa do Tailscale no PC e no iPhone + 'tailscale serve' (docs/tailscale-setup.md). Nunca use 'tailscale funnel'."/>
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Tokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostRound}" Content="&#xE711;" ToolTip="Revogar"
                                            Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" FontSize="11"
                                               Foreground="{StaticResource InkLo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Direita: pareamento (QR) ou atividade recente -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <StackPanel Visibility="{Binding HasPairing, Converter={StaticResource BoolToVis}}">
                    <Border Background="White" CornerRadius="10" Padding="8" HorizontalAlignment="Center"
                            Visibility="{Binding QrImage, Converter={StaticResource NullToCollapsed}}">
                        <Image Source="{Binding QrImage}" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="Aponte a câmera do iPhone. O token aparece só agora." FontSize="11" Foreground="{StaticResource InkLo}"
                               TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding PairLink, Mode=OneWay}" IsReadOnly="True" FontSize="11"/>
                    <Button Style="{StaticResource SmallButton}" Content="Copiar" Command="{Binding CopyPairLinkCommand}"
                            HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Visibility="{Binding HasPairing, Converter={StaticResource NotBoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="Atividade" Style="{StaticResource Label}"/>
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="11" Foreground="{StaticResource InkLo}" Width="40"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontSize="11" Foreground="{StaticResource InkLo}"/>
                                    <TextBlock Text="{Binding Action}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
