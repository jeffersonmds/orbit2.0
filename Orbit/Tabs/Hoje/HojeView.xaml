<UserControl x:Class="Orbit.Tabs.Hoje.HojeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Relógio + clima -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Time}" FontSize="56" FontWeight="Light" Margin="0,-10,0,0"
                       Typography.NumeralAlignment="Tabular"/>
            <TextBlock Text="{Binding Date}" FontSize="13" Foreground="{StaticResource InkLo}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}" DataContext="{Binding Weather}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Symbol" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Temp}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding City}" FontSize="12" Foreground="{StaticResource InkLo}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Condition}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource InkLo}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,2,0,8">
                        <Run Text="{Binding Sun, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RainChance, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Forecast}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Day}" FontSize="11" Foreground="{StaticResource InkLo}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Symbol" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MaxMin}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Pomodoro -->
        <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Pomodoro}" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="112" Height="112" Margin="0,4,0,10">
                    <Ellipse Stroke="#2A2A2E" StrokeThickness="6"/>
                    <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="6" StrokeDashCap="Round"
                             StrokeDashArray="{Binding RingDashArray}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="{StaticResource InkLo}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding CycleDots}" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse x:Name="dot" Width="6" Height="6" Margin="3,0" Fill="#3A3A40"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="True">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RoundButton}" Content="{Binding PlayGlyph}" Command="{Binding ToggleCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource RoundButton}" Content="&#xE72C;" Command="{Binding ResetCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Semana + tarefas -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding Week}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="bg" CornerRadius="9" Padding="0,5" Margin="1,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="10" Foreground="{StaticResource InkLo}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="num" Text="{Binding Day}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock Text="{Binding TodoCounter}" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource InkLo}"/>
                <TextBlock Text="Tarefas" Style="{StaticResource Label}" Margin="0"/>
            </DockPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Todos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostRound}" Content="&#xE711;"
                                        Command="{Binding DataContext.RemoveTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Command="{Binding DataContext.ToggleTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="2,4">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="box" Width="16" Height="16" CornerRadius="5" BorderThickness="1.5"
                                                BorderBrush="#4A4A50" Margin="0,0,8,0">
                                            <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Border>
                                        <TextBlock x:Name="txt" Text="{Binding Text}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource InkLo}"/>
                                    <Setter TargetName="txt" Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBox Grid.Row="3" Style="{StaticResource Field}" Margin="0,8,0,0"
                     Text="{Binding NewTodo, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddTodoCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
    </Grid>
</UserControl>
