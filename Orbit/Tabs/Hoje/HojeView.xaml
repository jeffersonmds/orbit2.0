<UserControl x:Class="Orbit.Tabs.Hoje.HojeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Duas colunas de cartões (proposta A): hora/clima/foco | semana+agenda/tarefas -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <TextBlock Text="{Binding Time}" FontSize="44" FontWeight="Light" Margin="0,-10,0,-2"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource InkLo}"/>
            </StackPanel>

            <!-- Clima -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" DataContext="{Binding Weather}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Symbol" FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Temp}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding City}" FontSize="11" Foreground="{StaticResource InkLo}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,3" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Condition}" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Stale}" FontSize="11" Foreground="#FF9F0A"
                               Visibility="{Binding Stale, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,1,0,6" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Details}">
                        <Run Text="{Binding Sun, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RainChance, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Forecast}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Day}" FontSize="10" Foreground="{StaticResource InkLo}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Symbol" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MaxMin}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Foco (Pomodoro) + timer rápido, compacto no pé da coluna -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="10,8">
                <StackPanel>
                    <DockPanel DataContext="{Binding Pomodoro}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Content="&#xE72C;" Command="{Binding ResetCommand}"
                                ToolTip="Recomeçar"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Content="{Binding PlayGlyph}" Command="{Binding ToggleCommand}"
                                Margin="0,0,6,0"/>
                        <Grid Width="34" Height="34" Margin="0,0,10,0">
                            <Ellipse Stroke="#2A2A2E" StrokeThickness="3.5"/>
                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.5" StrokeDashCap="Round"
                                     StrokeDashArray="{Binding RingDashArray}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,0,6,0"/>
                                <ItemsControl ItemsSource="{Binding CycleDots}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse x:Name="dot" Width="4" Height="4" Margin="1.5,0" Fill="#3A3A40"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="True">
                                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <!-- Timer rápido (independente do Pomodoro) -->
                    <Grid DataContext="{Binding Timer}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}">
                            <TextBlock Text="Timer" FontSize="11" Foreground="{StaticResource InkLo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SmallButton}" Content="5" Command="{Binding StartCommand}" CommandParameter="5" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallButton}" Content="10" Command="{Binding StartCommand}" CommandParameter="10" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallButton}" Content="25" Command="{Binding StartCommand}" CommandParameter="25"/>
                        </StackPanel>
                        <DockPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Cancelar" Command="{Binding CancelCommand}"/>
                            <TextBlock Text="{Binding Display}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Semana + agenda (links iCal de Ajustes; sem link, só a semana) -->
            <Border Style="{StaticResource Card}" Padding="10,8,12,10">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Week}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PlainButton}" Padding="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="bg" CornerRadius="9" Padding="0,4,0,2" Margin="1,0" Background="Transparent">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="10" Foreground="{StaticResource InkLo}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="num" Text="{Binding Day}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <!-- Pontinho: dia com evento na agenda. -->
                                            <Ellipse x:Name="dot" Width="4" Height="4" Margin="0,2,0,0" Fill="{DynamicResource AccentBrush}" Visibility="Hidden"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                        <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#2A2A2E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel DataContext="{Binding Agenda}" Margin="2,8,0,0"
                                Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" FontSize="11" Foreground="#FF9F0A"/>
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Label}" Margin="0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Empty}" FontSize="12" Foreground="{StaticResource InkLo}"
                                   Visibility="{Binding Empty, Converter={StaticResource NullToCollapsed}}"/>
                        <ItemsControl ItemsSource="{Binding Today}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Button x:Name="join" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Entrar" FontSize="11"
                                                Visibility="Collapsed" VerticalAlignment="Center" Padding="0"
                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Color}"
                                                 Visibility="{Binding Color, Converter={StaticResource NullToCollapsed}}"/>
                                        <TextBlock x:Name="when" Text="{Binding When}" Width="78" FontSize="12" Foreground="{StaticResource InkLo}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasJoin}" Value="True">
                                            <Setter TargetName="join" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNow}" Value="True">
                                            <Setter TargetName="when" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding More}" FontSize="11" Foreground="{StaticResource InkLo}"
                                   Visibility="{Binding More, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tarefas -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding TodoCounter}" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource InkLo}"/>
                        <TextBlock Text="Tarefas" Style="{StaticResource Label}" Margin="0"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Todos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostRound}" Content="&#xE711;"
                                                Command="{Binding DataContext.RemoveTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <!-- Horário do lembrete: chip na cor de destaque -->
                                        <Border x:Name="due" DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Margin="6,0,2,0" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Visibility="{Binding DueLabel, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock x:Name="dueText" Text="{Binding DueLabel}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Button Command="{Binding DataContext.ToggleTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource PlainButton}"
                                                HorizontalContentAlignment="Left" Padding="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="box" Width="15" Height="15" CornerRadius="4" BorderThickness="1.5"
                                                        BorderBrush="#4A4A50" Margin="0,0,8,0">
                                                    <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                               Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Border>
                                                <TextBlock x:Name="txt" Text="{Binding Text}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource InkLo}"/>
                                            <Setter TargetName="txt" Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter TargetName="due" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="dueText" Property="Foreground" Value="{StaticResource InkLo}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBox Grid.Row="2" Style="{StaticResource Field}" Margin="0,6,0,0"
                             ToolTip="Lembrete no fim: 15:30 · às 9h · amanhã 9h · em 30 min · em 2h"
                             Text="{Binding NewTodo, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTodoCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
