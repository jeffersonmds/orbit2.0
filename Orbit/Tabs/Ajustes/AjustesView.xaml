<UserControl x:Class="Orbit.Tabs.Ajustes.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="5,0">
            <TextBlock Text="Cor de destaque" Style="{StaticResource Label}"/>
            <ItemsControl ItemsSource="{Binding Opcoes}" Margin="-5,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="5"
                                Command="{Binding DataContext.EscolherAcentoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="{Binding Amostra}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Nome}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Abas" Style="{StaticResource Label}"/>
            <ItemsControl ItemsSource="{Binding Abas}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource Chip}" Content="{Binding Title}" IsChecked="{Binding Visible}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Alertas" Style="{StaticResource Label}"/>
            <WrapPanel Margin="0,0,0,10">
                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AlertasComoToast}"
                          Content="Em tela cheia, virar notificação do Windows"/>
                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding SomClaude}" Content="Som nos alertas do Claude"/>
            </WrapPanel>
            <TextBlock Text="Pomodoro (minutos)" Style="{StaticResource Label}"/>
            <WrapPanel Margin="0,0,0,10">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Foco" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource Field}" Width="64" Text="{Binding FocoTexto, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Pausa" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource Field}" Width="64" Text="{Binding PausaTexto, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Pausa longa" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource Field}" Width="64" Text="{Binding PausaLongaTexto, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Ciclos" FontSize="11" Foreground="{StaticResource InkLo}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource Field}" Width="64" Text="{Binding CiclosTexto, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding SomPomodoro}" Content="Som na troca de fase"
                          VerticalAlignment="Bottom"/>
            </WrapPanel>
            <!-- novas seções entram acima desta linha -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
