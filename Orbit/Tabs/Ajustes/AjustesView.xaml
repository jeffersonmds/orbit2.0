<UserControl x:Class="Orbit.Tabs.Ajustes.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Cor de destaque" Foreground="{StaticResource InkLo}" FontSize="12" Margin="5,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Opcoes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource CardButton}" Margin="5"
                            Command="{Binding DataContext.EscolherAcentoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="{Binding Amostra}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Nome}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
