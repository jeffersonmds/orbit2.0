<Window x:Class="Orbit.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:energia="clr-namespace:Orbit.Tabs.Energia"
        xmlns:ajustes="clr-namespace:Orbit.Tabs.Ajustes"
        xmlns:controles="clr-namespace:Orbit.Tabs.Controles"
        xmlns:stats="clr-namespace:Orbit.Tabs.Stats"
        xmlns:mercado="clr-namespace:Orbit.Tabs.Mercado"
        xmlns:hoje="clr-namespace:Orbit.Tabs.Hoje"
        xmlns:noticias="clr-namespace:Orbit.Tabs.Noticias"
        xmlns:claude="clr-namespace:Orbit.Tabs.Claude"
        xmlns:clips="clr-namespace:Orbit.Tabs.Clips"
        xmlns:apps="clr-namespace:Orbit.Tabs.Apps"
        xmlns:dispositivos="clr-namespace:Orbit.Tabs.Dispositivos"
        xmlns:notas="clr-namespace:Orbit.Tabs.Notas"
        Title="Orbit" Width="760" Height="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkHi}"
        KeyDown="OnKeyDown" Deactivated="OnDeactivated">
    <Window.Resources>
        <DataTemplate DataType="{x:Type dispositivos:DispositivosViewModel}">
            <dispositivos:DispositivosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type energia:EnergiaViewModel}">
            <energia:EnergiaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type hoje:HojeViewModel}">
            <hoje:HojeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ajustes:AjustesViewModel}">
            <ajustes:AjustesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type controles:ControlesViewModel}">
            <controles:ControlesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type stats:StatsViewModel}">
            <stats:StatsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type mercado:MercadoViewModel}">
            <mercado:MercadoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type noticias:NoticiasViewModel}">
            <noticias:NoticiasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type clips:ClipsViewModel}">
            <clips:ClipsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type claude:ClaudeViewModel}">
            <claude:ClaudeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type apps:AppsViewModel}">
            <apps:AppsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type notas:NotasViewModel}">
            <notas:NotasView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Fora da Pill a janela é alpha 0: o clique passa para o que está atrás. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
    <!-- Formato notch: orelhas côncavas nos cantos de cima (tamanho = raio da pílula, ajustado no code-behind) -->
    <Path x:Name="EarLeft" Width="5" Height="5" Stretch="Fill" Fill="{StaticResource IslandBg}" IsHitTestVisible="False"
          VerticalAlignment="Top" Data="M0,0 L8,0 L8,8 A8,8 0 0 0 0,0 Z"
          Visibility="{Binding NotchShape, Converter={StaticResource BoolToVis}}"/>
    <Border x:Name="Pill"
            Width="110" Height="10" CornerRadius="0,0,5,5" ClipToBounds="True"
            Background="{StaticResource IslandBg}"
            MouseEnter="OnPillEnter" MouseMove="OnPillMove" MouseLeave="OnPillLeave"
            MouseWheel="OnPillWheel" MouseLeftButtonUp="OnPillClick"
            AllowDrop="True" PreviewDragEnter="OnPillDragEnter" PreviewDragOver="OnPillDragOver"
            PreviewDragLeave="OnPillDragLeave" PreviewDrop="OnPillDrop">
        <Grid>
            <!-- As camadas são mostradas pelo code-behind ao fim da animação. -->
            <Grid x:Name="ActivityLayer" Visibility="Collapsed">
                <Grid x:Name="ActivityContent">
                    <DockPanel HorizontalAlignment="Center" Margin="14,0,38,0"
                               Visibility="{Binding ShowCameraMic, Converter={StaticResource NotBoolToVis}}">
                        <!-- Atualizando o Orbit: anel girando ao lado do texto -->
                        <TextBlock x:Name="UpdateSpinner" DockPanel.Dock="Left" Text="&#xE72C;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding ActivityText}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <!-- Câmera/microfone em uso: as bolinhas do aparelho (verde = câmera, laranja = microfone) -->
                    <DockPanel Margin="14,0" LastChildFill="True"
                               Visibility="{Binding ShowCameraMic, Converter={StaticResource BoolToVis}}">
                        <Ellipse x:Name="CameraMicDot" DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF9F0A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CameraMicView.Camera}" Value="True">
                                            <Setter Property="Fill" Value="#30D158"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CameraMicView.Time}" FontSize="11" Foreground="{StaticResource InkLo}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#30D158"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding CameraMicView.Camera, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding CameraMicView.Mic, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE720;"/>
                                    <Setter Property="Foreground" Value="#FF9F0A"/>
                                    <Style.Triggers>
                                        <!-- mudo global: microfone cortado, em vermelho -->
                                        <DataTrigger Binding="{Binding CameraMicView.MicMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xEC54;"/>
                                            <Setter Property="Foreground" Value="#FF453A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CameraMicView.App}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
                <!-- Barrinhas no ritmo da música (modo Discreta: só a mídia como atividade da vez) -->
                <StackPanel x:Name="AudioBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{DynamicResource AccentBrush}"/>
                    <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{DynamicResource AccentBrush}"/>
                    <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{DynamicResource AccentBrush}"/>
                    <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <!-- Pomodoro em curso (modo Discreta): barrinha de progresso da fase -->
                <Border Width="96" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"
                        Visibility="{Binding ShowPomodoroBar, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding PomodoroProgress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>

            <DockPanel x:Name="PeekLayer" Visibility="Collapsed" Margin="18,0" VerticalAlignment="Center">
                <!-- Ações do alerta (ex.: print → aparelho / Abrir) -->
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Peek.Actions}" VerticalAlignment="Center" Margin="8,0,0,0"
                              Visibility="{Binding Peek.HasActions, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SmallButton}" Content="{Binding Label}" Margin="4,0,0,0"
                                    Click="OnPeekAction" Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Miniatura do alerta (capa da música) -->
                <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="4" Margin="0,0,8,0" ClipToBounds="True"
                        VerticalAlignment="Center" Visibility="{Binding Peek.Image, Converter={StaticResource NullToCollapsed}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Peek.Image}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Peek.Bullet, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text="{Binding Peek.Title, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Peek.Detail}" FontSize="11" Foreground="{StaticResource InkLo}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Peek.Detail, Converter={StaticResource NullToCollapsed}}"/>
                    <!-- Barra de nível (volume, bateria) -->
                    <Border Height="4" CornerRadius="2" Background="#33FFFFFF" Margin="0,5,0,0"
                            Visibility="{Binding Peek.HasLevel, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Peek.Level, FallbackValue=0, TargetNullValue=0}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Grid x:Name="ExpandedLayer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ListBox Style="{StaticResource TabBar}" ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}" Margin="0,14,0,12"/>
                <ContentControl Grid.Row="1" Content="{Binding SelectedTab}" Margin="20,0,20,20"/>
            </Grid>

            <!-- Arrastando arquivo pra ilha: o painel vira zonas de soltar, uma por dispositivo -->
            <Border x:Name="DropHint" Visibility="Collapsed" Background="{StaticResource IslandBg}" Margin="10"
                    CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}">
                <Grid>
                <!-- Sem zonas (ponte desligada): o drop cai no seletor, que avisa o que fazer -->
                <TextBlock Text="Solte pra mandar" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DropTargets.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding DropTargets}" Margin="12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Margin="4" CornerRadius="12" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Solte pra mandar" FontSize="12"
                                               Foreground="{StaticResource InkLo}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </Border>

            <!-- Jogo em tela cheia: faixa fina, só pra ver (o clique atravessa) -->
            <DockPanel x:Name="GameLayer" Visibility="Collapsed" Margin="14,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="&#xEC54;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FF453A"
                           VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Microfone mudo"
                           Visibility="{Binding MicMuted, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding GameStatsText}" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Border>
    <Path x:Name="EarRight" Width="5" Height="5" Stretch="Fill" Fill="{StaticResource IslandBg}" IsHitTestVisible="False"
          VerticalAlignment="Top" Data="M8,0 L0,0 L0,8 A8,8 0 0 1 8,0 Z"
          Visibility="{Binding NotchShape, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</Window>
