<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\orbit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\orbit.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel/minimal API da ponte (framework compartilhado, assinado pela Microsoft). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- PWA da ponte: servido de <saída>\wwwroot pelo Kestrel. -->
    <!-- Update não serve: lá %(RecursiveDir) é relativo à raiz do projeto (vira wwwroot\Bridge\wwwroot\...). -->
    <None Remove="Bridge\wwwroot\**\*" />
    <None Include="Bridge\wwwroot\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Autoatualização (Services/SelfUpdate): o build grava de onde veio e de qual commit, pra o Orbit
       instalado saber que está velho e se republicar a partir do código. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>
  <Target Name="OrbitCommit" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <!-- "6ac9043" ou "6ac9043-dirty" (alterações não commitadas); sem git, fica sem commit -->
    <Exec Command="git describe --always --dirty --abbrev=7" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
      <Output TaskParameter="ExitCode" PropertyName="OrbitGitExit" />
    </Exec>
    <PropertyGroup Condition="'$(OrbitGitExit)' != '0'">
      <SourceRevisionId></SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
